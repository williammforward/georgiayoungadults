# Caching rules. Pages themselves are always re-checked, so fixes show up at once.

# Versions 1 and 2 are frozen, so phones can keep their files for a year.
/assets/v1/*
  Cache-Control: public, max-age=31536000, immutable

/assets/v2/*
  Cache-Control: public, max-age=31536000, immutable

# Version 3 is edited in place: its code is re-checked every 5 minutes (bump ?v= to
# push a change out at once). Its images never change.
/assets/v3/css/*
  Cache-Control: public, max-age=300

/assets/v3/js/*
  Cache-Control: public, max-age=300

/assets/v3/map.svg
  Cache-Control: public, max-age=3600

/assets/v3/img/*
  Cache-Control: public, max-age=31536000, immutable

# Original artwork (used by version 1). These files are never edited in place.
/assets/hero-vertical.webp
  Cache-Control: public, max-age=2592000

/assets/hero-vertical.jpg
  Cache-Control: public, max-age=2592000

/assets/hero-wide.webp
  Cache-Control: public, max-age=2592000

/assets/hero-wide.jpg
  Cache-Control: public, max-age=2592000

/assets/vertical-blank-background.jpg
  Cache-Control: public, max-age=2592000

/assets/with-lockup-white.png
  Cache-Control: public, max-age=2592000

/assets/map.svg
  Cache-Control: public, max-age=2592000

/assets/favicon.svg
  Cache-Control: public, max-age=2592000

# Schedule and resources: short cache so edits reach phones within a minute.
/data/*
  Cache-Control: public, max-age=60
